# Server
PORT=5000
NODE_ENV=development

# URL of the Next.js frontend (used for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas dashboard -> your cluster -> "Connect" -> "Drivers"
# Looks like: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# JWT secrets - use long random strings, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary - get from: https://console.cloudinary.com/ (Dashboard page, after signup)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack - get TEST keys from: https://dashboard.paystack.com/#/settings/developer
# (toggle "Test Mode" in the dashboard to see test keys, they start with sk_test_ / pk_test_)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Delivery fee, in kobo, keyed by the customer's shipping state (see
# server/src/config/shippingRates.js for the built-in table). SHIPPING_FEE_KOBO
# is the fallback fee for any state not in the table (defaults to 300000 / NGN 3,000
# if unset). Override or add states without a redeploy via SHIPPING_RATES_KOBO_JSON,
# e.g. SHIPPING_RATES_KOBO_JSON={"Lagos":150000,"Abuja":300000}
SHIPPING_FEE_KOBO=200000
SHIPPING_RATES_KOBO_JSON=

# SMTP - used to send forgot-password and contact-form emails. Optional in
# development: if unset, the email is logged to the server console instead
# of sent. REQUIRED in production (NODE_ENV=production) - sendMail() throws
# instead of silently no-op'ing if SMTP_HOST is unset, so this can't fail
# quietly with real users.
#
# Using Brevo (https://www.brevo.com, free tier): Settings -> SMTP & API ->
# SMTP tab for SMTP_HOST/SMTP_USER/SMTP_PASS (SMTP_PASS is a generated SMTP
# key, not your account password). EMAIL_FROM must be a verified sender
# under Senders, Domains & Dedicated IPs -> Senders, or Brevo will reject
# the send.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
